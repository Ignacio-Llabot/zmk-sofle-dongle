#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// LAYOUT: los argumentos se escriben en el orden fisico del dibujo de cada capa
// (banda por banda, de izquierda a derecha) y la macro los reordena al orden
// fila por fila que espera ZMK. kNN = posicion NN en ese orden de ZMK.
#define LAYOUT( \
    k00, k01, k02, k03, k04, k05, k06, k07, k08, k09, k10, k11, k12, k13, k14, k15, k16, k17, k18, k32, k58, k45, k20, k21, k22, k23, k24, k25, k26, k27, k28, k29, k30, k31, k19, k33, k34, k35, k36, k37, k38, k39, k40, k41, k42, k43, k44, k52, k46, k47, k48, k49, k50, k51, k53, k54, k55, k61, k62, k63, k56, k57, k59, k60 \
) \
    k00 k01 k02 k03 k04 k05 k06 k07 k08 k09 k10 k11 k12 k13 k14 k15 k16 k17 k18 k19 k20 k21 k22 k23 k24 k25 k26 k27 k28 k29 k30 k31 k32 k33 k34 k35 k36 k37 k38 k39 k40 k41 k42 k43 k44 k45 k46 k47 k48 k49 k50 k51 k52 k53 k54 k55 k56 k57 k58 k59 k60 k61 k62 k63

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };
   combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
            LAYOUT(
            /*+------------+---------+------------+---------------+---------------+---------+                       +-----------------+                        +-----------+---------+------------------+-------------+-----------+----------------+ */
            /*| ESC        | 1       | 2          | 3             | 4             | 5       |                       | ^               |                        | 6         | 7       | 8                | 9           | 0         | BKSP           | */
                &kp ESC,     &kp N1,   &kp N2,      &kp N3,         &kp N4,         &kp N5,                           &kp UP_ARROW,                              &kp N6,     &kp N7,   &kp N8,            &kp N9,       &kp N0,     &kp BACKSPACE,
            /*+------------+---------+------------+---------------+---------------+---------+     +-----------------+-----------------+------------------+     +-----------+---------+------------------+-------------+-----------+----------------+ */
            /*| TAB        | Q       | W          | E             | R             | T       |     | <               | ENTER           | >                |     | Y         | U       | I                | O           | P         | \              | */
                &kp TAB,     &kp Q,    &kp W,       &kp E,          &kp R,          &kp T,          &kp LEFT_ARROW,   &kp ENTER,        &kp RIGHT_ARROW,         &kp Y,      &kp U,    &kp I,             &kp O,        &kp P,      &kp BSLH,
            /*+------------+---------+------------+---------------+---------------+---------+     +-----------------+-----------------+------------------+     +-----------+---------+------------------+-------------+-----------+----------------+ */
            /*| CAPS       | A       | S          | D             | F             | G       |                       | v               |                        | H         | J       | K                | L           | ;         | '              | */
                &kp CAPS,    &kp A,    &kp S,       &kp D,          &kp F,          &kp G,                            &kp DOWN_ARROW,                            &kp H,      &kp J,    &kp K,             &kp L,        &kp SEMI,   &kp APOS,
            /*+------------+---------+------------+---------------+---------------+---------+     +-----------------+-----------------+                        +-----------+---------+------------------+-------------+-----------+----------------+ */
            /*| SHIFT      | Z       | X          | C             | V             | B       |     | MUTE            |                                          | N         | M       | ,                | .           | /         | ENTER          | */
                &kp LSHFT,   &kp Z,    &kp X,       &kp C,          &kp V,          &kp B,          &kp C_MUTE,                                                  &kp N,      &kp M,    &kp COMMA,         &kp DOT,      &kp FSLH,   &kp ENTER,
            /*+------------+---------+------------+---------------+---------------+---------+     +-----------------+                                          +-----------+---------+------------------+-------------+-----------+----------------+ */
            /*                       | CTRL       | GUI           | ALT           |                                                                                        | MO2     | SHIFT            | DEL         | */
                                       &kp LCTRL,   &kp LEFT_GUI,   &kp LEFT_ALT,                                                                                            &mo 2,    &kp RIGHT_SHIFT,   &kp DELETE,
            /*                       +------------+---------------+---------------+---------+     +-----------------+                 +------------------+     +-----------+---------+------------------+-------------+ */
            /*                                                                    | MO1     |     | SPACE           |                 | SPACE            |     | ENTER     | */
                                                                                    &mo 1,          &kp SPACE,                          &kp SPACE,               &kp ENTER
            /*                                                                    +---------+     +-----------------+                 +------------------+     +-----------+ */
            )
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;

            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
            LAYOUT(
            /*+------------+------------------+-----------------+------------------+------------------+------------------+                       +-----------------+                        +------------------+------------------+-------------+------------+-------------------+--------------------+ */
            /*| `          | F1               | F2              | F3               | F4               | F5               |                       | MV^             |                        | F6               | F7               | F8          | F9         | F10               | trans              | */
                &kp GRAVE,   &kp F1,            &kp F2,           &kp F3,            &kp F4,            &kp F5,                                    &mmv MOVE_UP,                              &kp F6,            &kp F7,            &kp F8,       &kp F9,      &kp F10,            &trans,
            /*+------------+------------------+-----------------+------------------+------------------+------------------+     +-----------------+-----------------+------------------+     +------------------+------------------+-------------+------------+-------------------+--------------------+ */
            /*| trans      | `                | LCLK            | MCLK             | RCLK             | MB4              |     | MV<             | LCLK            | MV>              |     | PGUP             | END              | ^           | HOME       | -                 | =                  | */
                &trans,      &kp GRAVE,         &mkp LCLK,        &mkp MCLK,         &mkp RCLK,         &mkp MB4,                &mmv MOVE_LEFT,   &mkp LCLK,        &mmv MOVE_RIGHT,         &kp PG_UP,         &kp END,           &kp UP,       &kp HOME,    &kp MINUS,          &kp EQUAL,
            /*+------------+------------------+-----------------+------------------+------------------+------------------+     +-----------------+-----------------+------------------+     +------------------+------------------+-------------+------------+-------------------+--------------------+ */
            /*| trans      | ~                | trans           | trans            | trans            | MB5              |                       | MVv             |                        | PGDN             | <                | v           | >          | [                 | ]                  | */
                &trans,      &kp TILDE,         &trans,           &trans,            &trans,            &mkp MB5,                                  &mmv MOVE_DOWN,                            &kp PG_DN,         &kp LEFT,          &kp DOWN,     &kp RIGHT,   &kp LEFT_BRACKET,   &kp RIGHT_BRACKET,
            /*+------------+------------------+-----------------+------------------+------------------+------------------+     +-----------------+-----------------+                        +------------------+------------------+-------------+------------+-------------------+--------------------+ */
            /*| trans      | RGB_OFF          | RGB_ON          | RGB_EFF          | RGB_EFR          | RGB_SPI          |     | MUTE            |                                          | RGB_BRI          | RGB_BRD          | INSERT      | F11        | F12               | trans              | */
                &trans,      &rgb_ug RGB_OFF,   &rgb_ug RGB_ON,   &rgb_ug RGB_EFF,   &rgb_ug RGB_EFR,   &rgb_ug RGB_SPI,         &kp C_MUTE,                                                  &rgb_ug RGB_BRI,   &rgb_ug RGB_BRD,   &kp INSERT,   &kp F11,     &kp F12,            &trans,
            /*+------------+------------------+-----------------+------------------+------------------+------------------+     +-----------------+                                          +------------------+------------------+-------------+------------+-------------------+--------------------+ */
            /*                                | trans           | trans            | trans            |                                                                                                        | trans            | trans       | trans      | */
                                                &trans,           &trans,            &trans,                                                                                                                     &trans,            &trans,       &trans,
            /*                                +-----------------+------------------+------------------+------------------+     +-----------------+                 +------------------+     +------------------+------------------+-------------+------------+ */
            /*                                                                                        | trans            |     | trans           |                 | trans            |     | trans            | */
                                                                                                        &trans,                  &trans,                             &trans,                  &trans
            /*                                                                                        +------------------+     +-----------------+                 +------------------+     +------------------+ */
            )
            >;

            display-name = "layer1";
            sensor-bindings = <&rsr_vol &rsr_trans>;
            
        };

        layer_2 {
            bindings = <
            LAYOUT(
            /*+------------+---------------+-----------------+---------------+---------------+---------------+                       +-----------------+                        +---------+---------+-------------+------------+--------------+-----------+ */
            /*| ~          | BT_SEL 0      | BT_SEL 1        | BT_SEL 2      | BT_SEL 3      | BT_SEL 4      |                       | MV^             |                        | F6      | F7      | F8          | F9         | F10          | trans     | */
                &kp TILDE,   &bt BT_SEL 0,   &bt BT_SEL 1,     &bt BT_SEL 2,   &bt BT_SEL 3,   &bt BT_SEL 4,                           &mmv MOVE_UP,                              &kp F6,   &kp F7,   &kp F8,       &kp F9,      &kp F10,       &trans,
            /*+------------+---------------+-----------------+---------------+---------------+---------------+     +-----------------+-----------------+------------------+     +---------+---------+-------------+------------+--------------+-----------+ */
            /*| trans      | BT_CLR        | BT_CLR_ALL      | trans         | trans         | trans         |     | MV<             | LCLK            | MV>              |     | trans   | trans   | F11         | F12        | _            | +         | */
                &trans,      &bt BT_CLR,     &bt BT_CLR_ALL,   &trans,         &trans,         &trans,               &mmv MOVE_LEFT,   &mkp LCLK,        &mmv MOVE_RIGHT,         &trans,   &trans,   &kp F11,      &kp F12,     &kp UNDER,     &kp PLUS,
            /*+------------+---------------+-----------------+---------------+---------------+---------------+     +-----------------+-----------------+------------------+     +---------+---------+-------------+------------+--------------+-----------+ */
            /*| trans      | OUT_USB       | OUT_BLE         | trans         | trans         | trans         |                       | MVv             |                        | trans   | trans   | trans       | trans      | {            | }         | */
                &trans,      &out OUT_USB,   &out OUT_BLE,     &trans,         &trans,         &trans,                                 &mmv MOVE_DOWN,                            &trans,   &trans,   &trans,       &trans,      &kp LBRC,      &kp RBRC,
            /*+------------+---------------+-----------------+---------------+---------------+---------------+     +-----------------+-----------------+                        +---------+---------+-------------+------------+--------------+-----------+ */
            /*| trans      | sys_reset     | trans           | bootloader    | trans         | trans         |     | trans           |                                          | trans   | trans   | sys_reset   | soft_off   | bootloader   | trans     | */
                &trans,      &sys_reset,     &trans,           &bootloader,    &trans,         &trans,               &trans,                                                      &trans,   &trans,   &sys_reset,   &soft_off,   &bootloader,   &trans,
            /*+------------+---------------+-----------------+---------------+---------------+---------------+     +-----------------+                                          +---------+---------+-------------+------------+--------------+-----------+ */
            /*                             | trans           | trans         | trans         |                                                                                            | trans   | trans       | trans      | */
                                             &trans,           &trans,         &trans,                                                                                                      &trans,   &trans,       &trans,
            /*                             +-----------------+---------------+---------------+---------------+     +-----------------+                 +------------------+     +---------+---------+-------------+------------+ */
            /*                                                                               | trans         |     | trans           |                 | trans            |     | trans   | */
                                                                                               &trans,               &trans,                             &trans,                  &trans
            /*                                                                               +---------------+     +-----------------+                 +------------------+     +---------+ */
            )
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            bindings = <
            LAYOUT(
            /*+---------+---------+---------+---------+---------+---------+               +---------+               +---------+---------+---------+---------+---------+---------+ */
            /*| trans   | trans   | trans   | trans   | trans   | trans   |               | trans   |               | trans   | trans   | trans   | trans   | trans   | trans   | */
                &trans,   &trans,   &trans,   &trans,   &trans,   &trans,                   &trans,                   &trans,   &trans,   &trans,   &trans,   &trans,   &trans,
            /*+---------+---------+---------+---------+---------+---------+     +---------+---------+---------+     +---------+---------+---------+---------+---------+---------+ */
            /*| trans   | trans   | trans   | trans   | trans   | trans   |     | trans   | trans   | trans   |     | trans   | trans   | trans   | trans   | trans   | trans   | */
                &trans,   &trans,   &trans,   &trans,   &trans,   &trans,         &trans,   &trans,   &trans,         &trans,   &trans,   &trans,   &trans,   &trans,   &trans,
            /*+---------+---------+---------+---------+---------+---------+     +---------+---------+---------+     +---------+---------+---------+---------+---------+---------+ */
            /*| trans   | trans   | trans   | trans   | trans   | trans   |               | trans   |               | trans   | trans   | trans   | trans   | trans   | trans   | */
                &trans,   &trans,   &trans,   &trans,   &trans,   &trans,                   &trans,                   &trans,   &trans,   &trans,   &trans,   &trans,   &trans,
            /*+---------+---------+---------+---------+---------+---------+     +---------+---------+               +---------+---------+---------+---------+---------+---------+ */
            /*| trans   | trans   | trans   | trans   | trans   | trans   |     | trans   |                         | trans   | trans   | trans   | trans   | trans   | trans   | */
                &trans,   &trans,   &trans,   &trans,   &trans,   &trans,         &trans,                             &trans,   &trans,   &trans,   &trans,   &trans,   &trans,
            /*+---------+---------+---------+---------+---------+---------+     +---------+                         +---------+---------+---------+---------+---------+---------+ */
            /*                    | trans   | trans   | trans   |                                                             | trans   | trans   | trans   | */
                                    &trans,   &trans,   &trans,                                                                 &trans,   &trans,   &trans,
            /*                    +---------+---------+---------+---------+     +---------+         +---------+     +---------+---------+---------+---------+ */
            /*                                                  | trans   |     | trans   |         | trans   |     | trans   | */
                                                                  &trans,         &trans,             &trans,         &trans
            /*                                                  +---------+     +---------+         +---------+     +---------+ */
            )
            >;
        };
    };
};



